# Perfil de 8 GB de RAM en Docker (detectado: 8244129792 bytes = 7.68 GB, 8 CPUs)
# Regla de oro: WORKERS x WORKER_MEMORY + DRIVER_MEMORY = 2x2g + 2g = 6g << 7.68g
# EXECUTOR_MEMORY (2g) <= WORKER_MEMORY (2g)

SPARK_VERSION=4.0.1

SPARK_WORKERS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

PUERTO_MASTER_UI=8080
PUERTO_MASTER=7077
PUERTO_JUPYTER=8889
PUERTO_DRIVER_UI=4040
PUERTO_HISTORY_UI=18080

JUPYTER_TOKEN=lab-sitio3
